+}
+
+double*** readImagesRange(char* filename, int offset, int count) {
+    FILE* f = fopen(filename, "rb");
+    assert(f != NULL);
+
+    uint32_t header[4];
+    (void) !fread(header, sizeof(uint32_t), 4, f);
+    int height = (int)swapEndian(header[2]);
+    int width = (int)swapEndian(header[3]);
+
+    fseek(f, 16 + (long)offset * width * height, SEEK_SET);
+    double*** images = malloc(count * sizeof(double**));
+    assert(images != NULL);
+    for (int i=0; i<count; i++) {
+        images[i] = readImage(f, width, height);
+    }
+
+    fclose(f);
+    return images;
+}
+
+int* readLabelsRange(char* filename, int offset, int count) {
+    FILE* f = fopen(filename, "rb");
+    assert(f != NULL);
+
+    int* labels = malloc(count * sizeof(int));
+    assert(labels != NULL);
+    unsigned char buffer[count];
+    fseek(f, 8 + offset, SEEK_SET);
+    (void) !fread(buffer, sizeof(unsigned char), count, f);
+
+    for (int i=0; i<count; i++) {
+        labels[i] = (int)buffer[i];
+    }
+
+    fclose(f);
+    return labels;
+}
